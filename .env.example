OPENAI_API_KEY=your_openai_api_key_here
# Keep the proven model on the cheaper path. Cost should be reduced by avoiding duplicate calls, not by moving to a more expensive model.
OPENAI_UI_REVIEW_MODEL=gpt-4o-mini
OPENAI_UI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_UI_FALLBACK_MODEL=gpt-4o-mini
# CAD flows can stay on the same proven model unless you intentionally override them.
OPENAI_UI_CAD_CLASSIFIER_MODEL=gpt-4o-mini
OPENAI_UI_CAD_CRITICAL_MODEL=gpt-4o-mini
# Set to true only if you really want AI review to run live while editing drafts.
VITE_ENABLE_DRAFT_LLM_REVIEW=false
PORT=8787
ALLOWED_ORIGINS=
VITE_API_BASE_URL=
